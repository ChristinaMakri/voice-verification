# Copy to .env and fill in. Never commit .env.

# base64-encoded 32-byte key. Generate: vv-keygen
#   (or: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())")
VV_ENCRYPTION_KEY=
# Shared secret that clients send as the X-API-Key header.
VV_API_KEY=

VV_DATABASE_URL=postgresql://vv:vv@db:5432/voiceprints
# Calibration (required for /verify): files from vv-build-cohort and vv-calibrate,
# mounted read-only from ./config (see docker-compose.yml).
VV_CALIBRATION_PATH=/config/calibration.json
VV_COHORT_PATH=/config/cohort.npz

# Development only: verify with a raw cosine threshold when uncalibrated.
# Unsafe: on Greek Common Voice, 0.25 accepted 18.5% of impostors.
VV_ALLOW_UNCALIBRATED=false
VV_THRESHOLD=0.25
VV_MIN_ENROLL_SPEECH_S=8
VV_MIN_VERIFY_SPEECH_S=2
VV_MAX_SAMPLES_PER_USER=10
VV_MODEL_CACHE_DIR=/models
